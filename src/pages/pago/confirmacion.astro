---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buscarTransaccionPorReferencia } from '../../lib/transacciones';

const refPayco = Astro.url.searchParams.get('ref_payco');
const response = Astro.url.searchParams.get('x_response');
const transactionId = Astro.url.searchParams.get('x_transaction_id');
const amount = Astro.url.searchParams.get('x_amount');
const currency = Astro.url.searchParams.get('x_currency_code');
const franchise = Astro.url.searchParams.get('x_franchise');
const approvalCode = Astro.url.searchParams.get('x_approval_code');
const responseReason = Astro.url.searchParams.get('x_response_reason_text');

// Extra data
const extra2 = Astro.url.searchParams.get('x_extra2');
const extra3 = Astro.url.searchParams.get('x_extra3');
const extra4 = Astro.url.searchParams.get('x_extra4');
const extra5 = Astro.url.searchParams.get('x_extra5');

let bookingInfo: { f?: string; h?: string; n?: string } | null = null;
if (extra2 || extra3 || extra4) {
  bookingInfo = {
    f: extra2 || undefined,
    h: extra3 || undefined,
    n: extra4 || undefined,
  };
}

// Verificar transaccion en base de datos local
const tx = refPayco ? buscarTransaccionPorReferencia(refPayco) : null;

function mapStatus(status: string | null): string {
  switch (status) {
    case 'Aceptada': return 'approved';
    case 'Rechazada': return 'rejected';
    case 'Pendiente': return 'pending';
    case 'Fallida': return 'failed';
    default: return 'unknown';
  }
}

const mappedStatus = mapStatus(response);
---

<BaseLayout
  title="Confirmación de pago | Abogado Juan Felipe Restrepo Sánchez"
  description="Resultado del pago de tus servicios legales."
>
  <main class="min-h-screen bg-[#e5e1e6] py-20">
    <div class="max-w-lg mx-auto px-4 sm:px-6">
      <div class="bg-white p-8 rounded-lg shadow-soft text-center">
        {mappedStatus === 'approved' ? (
          <>
            <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <h1 class="font-headline text-2xl font-bold text-on-surface mb-2">
              ¡Pago exitoso!
            </h1>
            <p class="text-on-surface-variant mb-6">
              Gracias por tu pago. Hemos recibido la confirmación de forma correcta.
            </p>
            {refPayco && (
              <p class="text-sm text-on-surface-variant mb-6">
                ID de transacción: <span class="font-mono">{refPayco}</span>
              </p>
            )}
            {bookingInfo ? (
              <div class="bg-[#e5e1e6] p-4 rounded-md mb-6">
                <p class="text-sm font-semibold text-on-surface mb-2">
                  Asesoría agendada
                </p>
                <p class="text-sm text-on-surface-variant">
                  Fecha: {bookingInfo.f} a las {bookingInfo.h}
                </p>
                <p class="text-sm text-on-surface-variant">
                  Cliente: {bookingInfo.n}
                </p>
                <p class="text-xs text-on-surface-variant mt-2">
                  El evento ha sido agregado al calendario del abogado.
                </p>
              </div>
            ) : (
              <div class="bg-[#e5e1e6] p-4 rounded-md mb-6">
                <p class="text-sm text-on-surface-variant mb-2">
                  El abogado se comunicará contigo pronto para coordinar los siguientes pasos.
                </p>
              </div>
            )}
            <a
              href="https://wa.me/573107285035"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-md font-headline font-semibold text-sm bg-[#25D366] text-white hover:bg-[#1DA851] transition-all duration-200"
            >
              Contactar por WhatsApp
            </a>
          </>
        ) : mappedStatus === 'rejected' || mappedStatus === 'failed' ? (
          <>
            <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </div>
            <h1 class="font-headline text-2xl font-bold text-on-surface mb-2">
              Pago {mappedStatus === 'failed' ? 'fallido' : 'rechazado'}
            </h1>
            <p class="text-on-surface-variant mb-6">
              {responseReason || 'El pago no pudo ser procesado. Puedes intentar con otro medio de pago o contactar al abogado.'}
            </p>
            <div class="flex flex-col gap-3">
              <a
                href="/pago"
                class="inline-flex items-center justify-center px-6 py-3 rounded-md font-headline font-semibold text-sm bg-primary-container text-on-primary hover:bg-primary-fixed transition-all duration-200"
              >
                Intentar de nuevo
              </a>
              <a
                href="https://wa.me/573107285035"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center px-6 py-3 rounded-md font-headline font-semibold text-sm border border-secondary text-secondary hover:bg-secondary hover:text-on-secondary transition-all duration-200"
              >
                Contactar al abogado
              </a>
            </div>
          </>
        ) : mappedStatus === 'pending' ? (
          <>
            <div class="w-16 h-16 bg-yellow-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h1 class="font-headline text-2xl font-bold text-on-surface mb-2">
              Pago pendiente
            </h1>
            <p class="text-on-surface-variant mb-6">
              {franchise === 'CASH'
                ? 'Has elegido pagar en efectivo. Realiza el pago en el punto físico correspondiente para completar la transacción.'
                : 'Tu pago está siendo procesado. Te notificaremos cuando se confirme.'}
            </p>
            <a
              href="/"
              class="inline-flex items-center justify-center px-6 py-3 rounded-md font-headline font-semibold text-sm bg-primary-container text-on-primary hover:bg-primary-fixed transition-all duration-200"
            >
              Volver al inicio
            </a>
          </>
        ) : (
          <>
            <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h1 class="font-headline text-2xl font-bold text-on-surface mb-2">
              Procesando pago
            </h1>
            <p class="text-on-surface-variant mb-6">
              Estamos procesando tu pago. Te notificaremos cuando se confirme.
            </p>
            <a
              href="/"
              class="inline-flex items-center justify-center px-6 py-3 rounded-md font-headline font-semibold text-sm bg-primary-container text-on-primary hover:bg-primary-fixed transition-all duration-200"
            >
              Volver al inicio
            </a>
          </>
        )}
      </div>
    </div>
  </main>
</BaseLayout>

<script define:vars={{ estadoInicial: mappedStatus }}>
  // Sistema de polling para verificar estado del pago
  let pollInterval = null;
  let pollCount = 0;
  const MAX_POLLS = 10;
  const POLL_INTERVAL = 3000; // 3 segundos

  async function verificarEstadoPago() {
    if (pollCount >= MAX_POLLS) {
      clearInterval(pollInterval);
      console.log('Maximo de intentos de verificacion alcanzado');
      return;
    }

    try {
      pollCount++;
      console.log(`Verificando estado del pago... (${pollCount}/${MAX_POLLS})`);
      
      // Aqui puedes agregar una llamada a tu API para verificar el estado real
      // const res = await fetch('/api/verificar-pago');
      // const data = await res.json();
      
    } catch (error) {
      console.error('Error al verificar estado:', error);
    }
  }

  // Iniciar polling si el estado es unknown o pending
  if (estadoInicial === 'unknown' || estadoInicial === 'pending') {
    pollInterval = setInterval(verificarEstadoPago, POLL_INTERVAL);
  }

  // Boton de reintentar pago - redirigir con datos guardados
  const retryBtn = document.getElementById('retry-payment-btn');
  if (retryBtn) {
    retryBtn.addEventListener('click', (e) => {
      e.preventDefault();
      try {
        const saved = localStorage.getItem('bookingSession');
        if (saved) {
          const datos = JSON.parse(saved);
          const cita = { f: datos.fecha, h: datos.hora, n: datos.nombre, t: datos.telefono };
          const citaStr = encodeURIComponent(btoa(JSON.stringify(cita)));
          window.location.href = `/pago?servicio=${datos.servicioId}&cita=${citaStr}`;
        } else {
          window.location.href = '/#servicios';
        }
      } catch (err) {
        window.location.href = '/#servicios';
      }
    });
  }

  // Limpiar datos de sesion si el pago fue exitoso
  if (estadoInicial === 'approved') {
    try {
      localStorage.removeItem('bookingSession');
      console.log('Sesion de booking limpiada exitosamente');
    } catch (e) {
      console.error('Error al limpiar localStorage:', e);
    }
  }
</script>
