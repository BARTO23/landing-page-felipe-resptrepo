---
import BaseLayout from '../layouts/BaseLayout.astro';
import { servicios } from '../data/servicios';

const servicioId = Astro.url.searchParams.get('servicio');
const servicio = servicios.find((s) => s.id === servicioId);

const horasDisponibles = [
  '08:00', '09:00', '10:00', '11:00',
  '14:00', '15:00', '16:00', '17:00',
];

const hoy = new Date();
const diasSemana = ['Lu', 'Ma', 'Mi', 'Ju', 'Vi', 'Sá', 'Do'];
const meses = [
  'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
  'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre',
];
---

<BaseLayout
  title={servicio ? `Agendar asesoría - ${servicio.titulo}` : 'Agendar no disponible'}
  description="Selecciona la fecha y hora para tu asesoría legal."
>
  <main class="min-h-screen bg-[#e5e1e6] py-20">
    <div class="max-w-2xl mx-auto px-4 sm:px-6">
      {servicio ? (
        <div class="space-y-8">
          {/* Progress Steps */}
          <div class="flex items-center justify-center space-x-4 mb-8">
            <div class="flex items-center">
              <div id="step-1" class="w-8 h-8 rounded-full bg-primary-container text-on-primary flex items-center justify-center text-sm font-bold step-active">1</div>
              <span class="ml-2 text-sm font-medium text-on-surface hidden sm:block">Agendar</span>
            </div>
            <div class="w-12 h-0.5 bg-gray-300" id="line-1-2"></div>
            <div class="flex items-center">
              <div id="step-2" class="w-8 h-8 rounded-full bg-gray-300 text-gray-500 flex items-center justify-center text-sm font-bold">2</div>
              <span class="ml-2 text-sm font-medium text-gray-500 hidden sm:block">Pago</span>
            </div>
            <div class="w-12 h-0.5 bg-gray-300" id="line-2-3"></div>
            <div class="flex items-center">
              <div id="step-3" class="w-8 h-8 rounded-full bg-gray-300 text-gray-500 flex items-center justify-center text-sm font-bold">3</div>
              <span class="ml-2 text-sm font-medium text-gray-500 hidden sm:block">Confirmación</span>
            </div>
          </div>

          <div class="text-center">
            <p class="text-secondary font-semibold text-sm tracking-[0.2em] uppercase mb-3">
              Agendar asesoría
            </p>
            <h1 class="font-headline text-3xl md:text-4xl font-bold text-primary-container mb-2">
              {servicio.titulo}
            </h1>
            <p class="text-on-surface-variant max-w-md mx-auto">
              {servicio.descripcion}
            </p>
            <div class="inline-flex items-center gap-2 mt-4 bg-white px-5 py-2 rounded-full shadow-soft">
              <svg class="w-4 h-4 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span class="text-sm font-semibold text-on-surface">
                ${servicio.precio.toLocaleString('es-CO')} COP · {servicio.duracion_minutos} min
              </span>
            </div>
          </div>

          <div id="reserva-timer" class="hidden bg-orange-50 border border-orange-200 rounded-lg p-4 mb-4">
            <div class="flex items-center justify-center gap-2 text-orange-700">
              <svg class="w-5 h-5 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span class="font-semibold">Su reserva expira en: <span id="timer-countdown" class="font-mono text-lg">20:00</span></span>
            </div>
            <p class="text-xs text-orange-600 text-center mt-1">Complete el pago antes de que expire el tiempo para asegurar su cita.</p>
          </div>

          <form id="booking-form">
            <input type="hidden" name="servicio_id" value={servicio.id} />
            <input type="hidden" id="fecha-hidden" name="fecha" value="" />
            <input type="hidden" id="hora-hidden" name="hora" value="" />

            <div class="bg-white rounded-xl shadow-soft overflow-hidden">
              <div class="bg-primary-container px-6 py-5 flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <svg class="w-6 h-6 text-on-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <h2 class="font-headline font-bold text-on-primary text-lg">
                    Selecciona el día
                  </h2>
                </div>
                <div class="flex items-center gap-2">
                  <button
                    type="button"
                    id="prev-month"
                    class="w-8 h-8 flex items-center justify-center rounded-md text-on-primary/70 hover:text-on-primary hover:bg-white/10 transition-all"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                    </svg>
                  </button>
                  <span id="month-label" class="font-headline font-semibold text-on-primary text-sm min-w-[140px] text-center"></span>
                  <button
                    type="button"
                    id="next-month"
                    class="w-8 h-8 flex items-center justify-center rounded-md text-on-primary/70 hover:text-on-primary hover:bg-white/10 transition-all"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </button>
                </div>
              </div>

              <div class="p-6">
                <div class="grid grid-cols-7 gap-1 text-center mb-3">
                  {diasSemana.map((d) => (
                    <span class="text-xs font-bold text-on-surface-variant/60 tracking-wider uppercase py-1">{d}</span>
                  ))}
                </div>
                <div id="days-grid" class="grid grid-cols-7 gap-1"></div>
              </div>
            </div>

            <div id="horario-section" class="bg-white rounded-xl shadow-soft overflow-hidden mt-6 hidden">
              <div class="bg-[#f0edf2] px-6 py-4 flex items-center gap-3">
                <svg class="w-5 h-5 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <h2 class="font-headline font-semibold text-on-surface text-base">
                  Horario disponible
                </h2>
                <div id="fecha-seleccionada-label" class="text-sm text-on-surface-variant ml-auto flex items-center gap-2"></div>
              </div>
              <div class="p-6">
                <div id="horario-loading" class="hidden flex items-center justify-center py-8">
                  <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary-container"></div>
                  <span class="ml-3 text-sm text-on-surface-variant">Verificando disponibilidad...</span>
                </div>
                <div id="horas-grid" class="grid grid-cols-3 sm:grid-cols-4 gap-3"></div>
                <p id="hora-error" class="text-xs text-red-600 mt-3 hidden">Selecciona una hora disponible</p>
              </div>
            </div>

            <div id="datos-section" class="bg-white rounded-xl shadow-soft overflow-hidden mt-6 hidden">
              <div class="bg-[#f0edf2] px-6 py-4 flex items-center gap-3">
                <svg class="w-5 h-5 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
                <h2 class="font-headline font-semibold text-on-surface text-base">
                  Tus datos
                </h2>
              </div>
              <div class="p-6 space-y-4">
                <div>
                  <label for="nombre" class="block text-sm font-semibold text-on-surface mb-1.5">
                    Nombre completo
                  </label>
                  <input
                    type="text"
                    id="nombre"
                    name="nombre"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all"
                    placeholder="Ej: Juan Pérez"
                    required
                  />
                  <p id="nombre-error" class="text-xs text-red-600 mt-1 hidden">Por favor ingrese su nombre completo</p>
                </div>
                <div>
                  <label for="telefono" class="block text-sm font-semibold text-on-surface mb-1.5">
                    Teléfono
                  </label>
                  <input
                    type="tel"
                    id="telefono"
                    name="telefono"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all"
                    placeholder="Ej: 300 123 4567"
                    required
                  />
                  <p id="telefono-error" class="text-xs text-red-600 mt-1 hidden">Por favor ingrese su número de teléfono</p>
                </div>
                <div>
                  <label for="email" class="block text-sm font-semibold text-on-surface mb-1.5">
                    Correo electrónico
                  </label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition-all"
                    placeholder="Ej: juan@correo.com"
                    required
                  />
                  <p id="email-error" class="text-xs text-red-600 mt-1 hidden">Ingrese un correo electrónico válido</p>
                  <p class="text-xs text-on-surface-variant mt-1">Le enviaremos la confirmación de su cita a este correo.</p>
                </div>
                <div id="form-error" class="text-sm text-red-600 hidden"></div>
                <button
                  type="submit"
                  id="continuar-btn"
                  class="w-full bg-primary-container text-on-primary font-headline font-semibold py-4 px-6 rounded-lg hover:bg-primary-fixed transition-all duration-200 text-lg flex items-center justify-center gap-2"
                >
                  <span id="btn-text">Continuar al pago — ${servicio.precio.toLocaleString('es-CO')} COP</span>
                  <div id="btn-spinner" class="hidden w-5 h-5 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
                </button>
              </div>
            </div>
          </form>
        </div>
      ) : (
        <div class="bg-white p-8 rounded-lg shadow-soft text-center max-w-lg mx-auto">
          <h1 class="font-headline text-2xl font-bold text-on-surface mb-4">
            Servicio no encontrado
          </h1>
          <p class="text-on-surface-variant mb-6">
            El servicio seleccionado no existe o ha sido desactivado.
          </p>
          <a
            href="/#servicios"
            class="inline-flex items-center justify-center px-6 py-3 rounded-md font-headline font-semibold text-sm bg-primary-container text-on-primary hover:bg-primary-fixed transition-all duration-200"
          >
            Ver servicios disponibles
          </a>
        </div>
      )}
    </div>
  </main>
</BaseLayout>

<script define:vars={{ servicioPrecio: servicio?.precio || 100000, servicioDuracion: servicio?.duracion_minutos || 60, servicioId: servicio?.id || '' }}>
  const hoy = new Date();
  hoy.setHours(0, 0, 0, 0);

  let mesActual = hoy.getMonth();
  let anioActual = hoy.getFullYear();
  let fechaSeleccionada = null;
  let horaSeleccionada = null;
  let horasBloqueadas = [];
  let reservaActual = null;
  let timerInterval = null;

  const monthLabel = document.getElementById('month-label');
  const daysGrid = document.getElementById('days-grid');
  const prevBtn = document.getElementById('prev-month');
  const nextBtn = document.getElementById('next-month');
  const fechaHidden = document.getElementById('fecha-hidden');
  const horaHidden = document.getElementById('hora-hidden');
  const horarioSection = document.getElementById('horario-section');
  const horasGrid = document.getElementById('horas-grid');
  const fechaLabel = document.getElementById('fecha-seleccionada-label');
  const datosSection = document.getElementById('datos-section');
  const horaError = document.getElementById('hora-error');
  const formError = document.getElementById('form-error');
  const form = document.getElementById('booking-form');
  const nombreInput = document.getElementById('nombre');
  const telefonoInput = document.getElementById('telefono');
  const emailInput = document.getElementById('email');
  const nombreError = document.getElementById('nombre-error');
  const telefonoError = document.getElementById('telefono-error');
  const emailError = document.getElementById('email-error');
  const btnContinuar = document.getElementById('continuar-btn');
  const btnText = document.getElementById('btn-text');
  const btnSpinner = document.getElementById('btn-spinner');
  const reservaTimer = document.getElementById('reserva-timer');
  const timerCountdown = document.getElementById('timer-countdown');
  const horarioLoading = document.getElementById('horario-loading');

  const nombresMeses = [
    'Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio',
    'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre',
  ];

  const horasDisponibles = [
    '08:00', '09:00', '10:00', '11:00',
    '14:00', '15:00', '16:00', '17:00',
  ];

  // === Funciones de utilidad ===
  function formatearFecha(year, month, day) {
    const m = String(month + 1).padStart(2, '0');
    const d = String(day).padStart(2, '0');
    return `${year}-${m}-${d}`;
  }

  function formatearFechaDisplay(year, month, day) {
    return `${day} de ${nombresMeses[month]} de ${year}`;
  }

  function esHabil(year, month, day) {
    const d = new Date(year, month, day);
    const dia = d.getDay();
    return dia !== 0 && dia !== 6;
  }

  function esPasado(year, month, day) {
    const d = new Date(year, month, day);
    return d < hoy;
  }

  function guardarEnLocalStorage() {
    const datos = {
      fecha: fechaSeleccionada,
      hora: horaSeleccionada,
      nombre: nombreInput.value.trim(),
      telefono: telefonoInput.value.trim(),
      servicioId: servicioId,
      reservaId: reservaActual?.id,
      timestamp: Date.now(),
    };
    localStorage.setItem('bookingSession', JSON.stringify(datos));
  }

  function recuperarDeLocalStorage() {
    try {
      const saved = localStorage.getItem('bookingSession');
      if (!saved) return null;
      const datos = JSON.parse(saved);
      // Solo recuperar si es del mismo servicio y menos de 30 minutos
      if (datos.servicioId === servicioId && Date.now() - datos.timestamp < 30 * 60 * 1000) {
        return datos;
      }
      return null;
    } catch {
      return null;
    }
  }

  function limpiarLocalStorage() {
    localStorage.removeItem('bookingSession');
  }

  function iniciarTimerReserva(expiraEn) {
    if (timerInterval) clearInterval(timerInterval);
    
    function actualizarTimer() {
      const ahora = Date.now();
      const expira = new Date(expiraEn).getTime();
      const restante = expira - ahora;
      
      if (restante <= 0) {
        clearInterval(timerInterval);
        reservaTimer.classList.add('hidden');
        alert('Su reserva ha expirado. Por favor seleccione una nueva fecha y hora.');
        location.reload();
        return;
      }
      
      const minutos = Math.floor(restante / 60000);
      const segundos = Math.floor((restante % 60000) / 1000);
      timerCountdown.textContent = `${String(minutos).padStart(2, '0')}:${String(segundos).padStart(2, '0')}`;
      reservaTimer.classList.remove('hidden');
    }
    
    actualizarTimer();
    timerInterval = setInterval(actualizarTimer, 1000);
  }

  async function verificarDisponibilidad(fecha) {
    try {
      horarioLoading.classList.remove('hidden');
      horasGrid.classList.add('hidden');
      
      const res = await fetch(`/api/disponibilidad?fecha=${fecha}`);
      const data = await res.json();
      
      if (data.horasBloqueadas) {
        horasBloqueadas = data.horasBloqueadas;
      }
      return data;
    } catch (error) {
      console.error('Error al verificar disponibilidad:', error);
      return { horasDisponibles, horasBloqueadas: [] };
    } finally {
      horarioLoading.classList.add('hidden');
      horasGrid.classList.remove('hidden');
    }
  }

  async function mostrarHorarios(fechaStr) {
    horarioSection.classList.remove('hidden');
    fechaLabel.textContent = formatearFechaDisplay(
      parseInt(fechaStr.split('-')[0]),
      parseInt(fechaStr.split('-')[1]) - 1,
      parseInt(fechaStr.split('-')[2])
    );

    await verificarDisponibilidad(fechaStr);

    let html = '';
    horasDisponibles.forEach((hora) => {
      const esSeleccionada = horaSeleccionada === hora;
      const estaBloqueada = horasBloqueadas.includes(hora);
      let clases = 'py-3 px-4 rounded-lg text-sm font-semibold transition-all duration-200 border-2 text-center ';

      if (estaBloqueada) {
        clases += 'bg-gray-100 text-gray-400 border-gray-200 cursor-not-allowed opacity-60';
      } else if (esSeleccionada) {
        clases += 'bg-primary-container text-on-primary border-primary-container ';
      } else {
        clases += 'bg-white text-on-surface border-gray-200 hover:border-secondary hover:text-secondary ';
      }

      html += `<button type="button" class="${clases}" data-hora="${hora}" ${estaBloqueada ? 'disabled' : ''}>${hora}</button>`;
    });

    horasGrid.innerHTML = html;

    horasGrid.querySelectorAll('button:not([disabled])').forEach((btn) => {
      btn.addEventListener('click', () => {
        horaSeleccionada = btn.dataset.hora;
        horaHidden.value = horaSeleccionada;
        horaError.classList.add('hidden');
        datosSection.classList.remove('hidden');
        datosSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        mostrarHorarios(fechaStr);
        guardarEnLocalStorage();
      });
    });
  }

  function renderizarCalendario(mes, anio) {
    monthLabel.textContent = `${nombresMeses[mes]} ${anio}`;

    prevBtn.disabled = mes === hoy.getMonth() && anio === hoy.getFullYear();
    prevBtn.classList.toggle('opacity-30', prevBtn.disabled);
    prevBtn.classList.toggle('cursor-not-allowed', prevBtn.disabled);

    const primerDia = new Date(anio, mes, 1);
    const ultimoDia = new Date(anio, mes + 1, 0);
    const diasEnMes = ultimoDia.getDate();
    let diaSemanaInicio = primerDia.getDay();
    diaSemanaInicio = diaSemanaInicio === 0 ? 6 : diaSemanaInicio - 1;

    let html = '';

    for (let i = 0; i < diaSemanaInicio; i++) {
      html += '<div></div>';
    }

    for (let d = 1; d <= diasEnMes; d++) {
      const fechaStr = formatearFecha(anio, mes, d);
      const esPas = esPasado(anio, mes, d);
      const esHab = esHabil(anio, mes, d);
      const seleccionada = fechaSeleccionada === fechaStr;

      let clases = 'relative py-2.5 text-sm rounded-lg transition-all duration-200 text-center ';

      if (esPas || !esHab) {
        clases += 'text-on-surface-variant/20 cursor-not-allowed ';
      } else if (seleccionada) {
        clases += 'bg-primary-container text-on-primary font-bold shadow-md ';
      } else {
        clases += 'text-on-surface cursor-pointer hover:bg-[#e5e1e6] hover:font-semibold ';
      }

      html += `<button type="button" class="${clases}" data-fecha="${fechaStr}" ${esPas || !esHab ? 'disabled' : ''}>${d}</button>`;
    }

    daysGrid.innerHTML = html;

    daysGrid.querySelectorAll('button:not([disabled])').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const fecha = btn.dataset.fecha;
        fechaSeleccionada = fecha;
        horaSeleccionada = null;
        horaHidden.value = '';
        fechaHidden.value = fecha;
        horarioSection.classList.add('hidden');
        datosSection.classList.add('hidden');
        renderizarCalendario(mesActual, anioActual);
        await mostrarHorarios(fecha);
        guardarEnLocalStorage();
      });
    });
  }

  prevBtn.addEventListener('click', () => {
    mesActual--;
    if (mesActual < 0) { mesActual = 11; anioActual--; }
    renderizarCalendario(mesActual, anioActual);
  });

  nextBtn.addEventListener('click', () => {
    mesActual++;
    if (mesActual > 11) { mesActual = 0; anioActual++; }
    renderizarCalendario(mesActual, anioActual);
  });

  // Validación en tiempo real
  nombreInput.addEventListener('blur', () => {
    if (nombreInput.value.trim()) {
      nombreError.classList.add('hidden');
    }
  });

  telefonoInput.addEventListener('blur', () => {
    if (telefonoInput.value.trim()) {
      telefonoError.classList.add('hidden');
    }
  });

  emailInput.addEventListener('blur', () => {
    if (/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailInput.value.trim())) {
      emailError.classList.add('hidden');
    }
  });

  renderizarCalendario(mesActual, anioActual);

  // Recuperar sesión guardada si existe
  const sesionGuardada = recuperarDeLocalStorage();
  
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    formError.classList.add('hidden');
    nombreError.classList.add('hidden');
    telefonoError.classList.add('hidden');

    const fecha = fechaHidden.value;
    const hora = horaHidden.value;
    const nombre = nombreInput.value.trim();
    const telefono = telefonoInput.value.trim();
    const email = emailInput.value.trim();
    const servicioId = form.querySelector('[name=servicio_id]').value;

    const camposFaltantes = [];
    if (!fecha) camposFaltantes.push('fecha');
    if (!hora) camposFaltantes.push('hora');
    if (!nombre) {
      camposFaltantes.push('nombre');
      nombreError.classList.remove('hidden');
    }
    if (!telefono) {
      camposFaltantes.push('teléfono');
      telefonoError.classList.remove('hidden');
    }
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      camposFaltantes.push('correo');
      emailError.classList.remove('hidden');
    }

    if (camposFaltantes.length > 0) {
      formError.textContent = `Completa todos los campos requeridos`;
      formError.classList.remove('hidden');
      return;
    }

    // Deshabilitar botón y mostrar loading
    btnContinuar.disabled = true;
    btnText.textContent = 'Creando reserva...';
    btnSpinner.classList.remove('hidden');

    try {
      // Crear reserva temporal en el servidor
      const res = await fetch('/api/reservar', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          servicioId,
          fecha,
          hora,
          nombre,
          telefono,
          email,
          precio: servicioPrecio,
          duracionMinutos: servicioDuracion,
        }),
      });

      const data = await res.json();

      if (!res.ok) {
        throw new Error(data.error || 'Error al crear la reserva');
      }

      // Guardar reserva actual
      reservaActual = {
        id: data.sessionId,
        expiraEn: data.expiraEn,
      };

      guardarEnLocalStorage();

      // Iniciar timer visual
      iniciarTimerReserva(data.expiraEn);

      // Redirigir a página de pago con session ID
      const cita = { f: fecha, h: hora, n: nombre, t: telefono, s: data.sessionId };
      const citaStr = encodeURIComponent(btoa(JSON.stringify(cita)));
      window.location.href = `/pago?servicio=${servicioId}&cita=${citaStr}`;
    } catch (err) {
      btnContinuar.disabled = false;
      btnText.textContent = `Continuar al pago — $${servicioPrecio.toLocaleString('es-CO')} COP`;
      btnSpinner.classList.add('hidden');
      formError.textContent = err instanceof Error ? err.message : 'Error inesperado. Intente nuevamente.';
      formError.classList.remove('hidden');
    }
  });
</script>
