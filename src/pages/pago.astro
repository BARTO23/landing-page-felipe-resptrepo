---
import BaseLayout from '../layouts/BaseLayout.astro';
import { servicios } from '../data/servicios';

const servicioId = Astro.url.searchParams.get('servicio');
const servicio = servicios.find((s) => s.id === servicioId);
const citaParam = Astro.url.searchParams.get('cita');

let citaData: Record<string, string> | null = null;
if (citaParam) {
  try {
    citaData = JSON.parse(atob(decodeURIComponent(citaParam)));
  } catch {
    citaData = null;
  }
}

// Verificar que tengamos sessionId de la reserva
const sessionId = citaData?.s || '';
---

<BaseLayout
  title={servicio ? `Pagar - ${servicio.titulo} | Abogado Juan Felipe Restrepo Sánchez` : 'Pago no disponible'}
  description="Realiza el pago de tus servicios legales de forma segura con ePayco."
>
  <main class="min-h-screen bg-[#e5e1e6] py-20">
    <div class="max-w-lg mx-auto px-4 sm:px-6">
      {servicio ? (
        <div class="space-y-6">
          {/* Progress Steps */}
          <div class="flex items-center justify-center space-x-4 mb-8">
            <div class="flex items-center">
              <div class="w-8 h-8 rounded-full bg-green-500 text-white flex items-center justify-center text-sm font-bold">✓</div>
              <span class="ml-2 text-sm font-medium text-on-surface hidden sm:block">Agendar</span>
            </div>
            <div class="w-12 h-0.5 bg-primary-container"></div>
            <div class="flex items-center">
              <div id="step-pago" class="w-8 h-8 rounded-full bg-primary-container text-on-primary flex items-center justify-center text-sm font-bold step-active">2</div>
              <span class="ml-2 text-sm font-medium text-on-surface hidden sm:block">Pago</span>
            </div>
            <div class="w-12 h-0.5 bg-gray-300"></div>
            <div class="flex items-center">
              <div class="w-8 h-8 rounded-full bg-gray-300 text-gray-500 flex items-center justify-center text-sm font-bold">3</div>
              <span class="ml-2 text-sm font-medium text-gray-500 hidden sm:block">Confirmación</span>
            </div>
          </div>

          <div class="bg-white p-8 rounded-lg shadow-soft">
            <div class="mb-8">
              <p class="text-secondary font-semibold text-sm tracking-[0.2em] uppercase mb-2">
                Pago de servicio
              </p>
              <h1 class="font-headline text-2xl font-bold text-on-surface">
                {servicio.titulo}
              </h1>
              <p class="text-on-surface-variant mt-2">
                {servicio.descripcion}
              </p>
            </div>

            {citaData && (
              <div class="bg-[#e5e1e6] p-4 rounded-md mb-6">
                <p class="text-sm font-semibold text-on-surface mb-2">Resumen de tu cita</p>
                <div class="space-y-1">
                  <p class="text-sm text-on-surface-variant">
                    <span class="font-medium">Fecha:</span> {citaData.f}
                  </p>
                  <p class="text-sm text-on-surface-variant">
                    <span class="font-medium">Hora:</span> {citaData.h}
                  </p>
                  <p class="text-sm text-on-surface-variant">
                    <span class="font-medium">Cliente:</span> {citaData.n}
                  </p>
                </div>
                
                {/* Timer de reserva */}
                <div id="reserva-timer-display" class="mt-3 hidden bg-orange-50 border border-orange-200 rounded p-3">
                  <div class="flex items-center justify-center gap-2 text-orange-700">
                    <svg class="w-4 h-4 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span class="text-xs font-semibold">Reserva activa: <span id="pago-timer-countdown" class="font-mono font-bold">--:--</span></span>
                  </div>
                </div>
              </div>
            )}

            <div class="border-t border-gray-200 pt-6 mb-8">
              <div class="flex justify-between items-center mb-2">
                <span class="text-on-surface-variant">Valor del servicio</span>
                <span class="font-headline text-2xl font-bold text-on-surface">
                  ${servicio.precio.toLocaleString('es-CO')} COP
                </span>
              </div>
              <p class="text-xs text-on-surface-variant">
                Impuestos incluidos. Pago único por servicio.
              </p>
            </div>

            <button
              id="epayco-pagar-btn"
              class="w-full bg-primary-container text-on-primary font-headline font-semibold py-3 px-6 rounded-md hover:bg-primary-fixed transition-all duration-200 disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center gap-3"
              data-servicio-id={servicio.id}
            >
              <span id="btn-text">Pagar con ePayco</span>
              <div id="btn-spinner" class="hidden w-5 h-5 border-2 border-white border-t-transparent rounded-full animate-spin"></div>
            </button>

            <div id="epayco-error" class="mt-4 text-red-600 text-sm hidden"></div>

            <div class="mt-6 pt-6 border-t border-gray-200">
              <p class="text-xs text-on-surface-variant text-center">
                Pago procesado de forma segura por ePayco.
                Aceptamos Nequi, Bancolombia, PSE, Daviplata y tarjetas.
              </p>
            </div>
          </div>

          {/* Botón para volver y modificar cita */}
          <div class="text-center">
            <a
              href={`/agendar?servicio=${servicioId}`}
              class="inline-flex items-center gap-2 text-sm text-on-surface-variant hover:text-primary-container transition-colors"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
              </svg>
              Modificar fecha o hora
            </a>
          </div>
        </div>
      ) : (
        <div class="bg-white p-8 rounded-lg shadow-soft text-center">
          <h1 class="font-headline text-2xl font-bold text-on-surface mb-4">
            Servicio no encontrado
          </h1>
          <p class="text-on-surface-variant mb-6">
            El servicio seleccionado no existe o ha sido desactivado.
          </p>
          <a
            href="/#servicios"
            class="inline-flex items-center justify-center px-6 py-3 rounded-md font-headline font-semibold text-sm bg-primary-container text-on-primary hover:bg-primary-fixed transition-all duration-200"
          >
            Ver servicios disponibles
          </a>
        </div>
      )}
    </div>
  </main>
</BaseLayout>

<script define:vars={{ citaData, sessionId: citaData?.s || '' }}>
  function cargarScriptEpayco() {
    return new Promise((resolve, reject) => {
      if (typeof ePayco !== 'undefined') {
        resolve();
        return;
      }
      const script = document.createElement('script');
      script.src = 'https://checkout.epayco.co/checkout-v2.js';
      script.onload = () => resolve();
      script.onerror = () => reject(new Error('No se pudo cargar el script de ePayco'));
      document.head.appendChild(script);
    });
  }

  const btn = document.getElementById('epayco-pagar-btn');
  const errorDiv = document.getElementById('epayco-error');
  const btnText = document.getElementById('btn-text');
  const btnSpinner = document.getElementById('btn-spinner');

  const payload = {
    servicio_id: btn?.dataset.servicioId || '',
  };

  if (citaData) {
    payload.fecha = citaData.f;
    payload.hora = citaData.h;
    payload.nombre_cliente = citaData.n;
    payload.telefono_cliente = citaData.t || '';
    payload.session_id = sessionId; // Pasar sessionId para vincular con reserva
  }

  const timerDisplay = document.getElementById('reserva-timer-display');
  const timerCountdown = document.getElementById('pago-timer-countdown');
  let timerInterval = null;

  function marcarReservaExpirada() {
    if (timerInterval) clearInterval(timerInterval);
    if (timerDisplay) {
      timerDisplay.innerHTML = `
        <div class="flex items-center gap-2 text-red-700">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span class="text-xs font-semibold">Su reserva ha expirado. Por favor regrese a seleccionar una nueva fecha.</span>
        </div>
      `;
      timerDisplay.classList.remove('hidden', 'bg-orange-50', 'border-orange-200');
      timerDisplay.classList.add('bg-red-50', 'border-red-200');
    }
    if (btn) {
      btn.disabled = true;
      btn.classList.add('opacity-50', 'cursor-not-allowed');
      btnText.textContent = 'Reserva expirada';
    }
  }

  function iniciarCuentaRegresiva(expiraEn) {
    if (!timerDisplay || !timerCountdown) return;
    timerDisplay.classList.remove('hidden');
    const expira = new Date(expiraEn).getTime();

    function tick() {
      const restante = expira - Date.now();
      if (restante <= 0) {
        timerCountdown.textContent = '00:00';
        marcarReservaExpirada();
        return;
      }
      const min = Math.floor(restante / 60000);
      const seg = Math.floor((restante % 60000) / 1000);
      timerCountdown.textContent = `${String(min).padStart(2, '0')}:${String(seg).padStart(2, '0')}`;
    }

    tick();
    timerInterval = setInterval(tick, 1000);
  }

  // Verificar estado de la reserva al cargar la página
  async function verificarReserva() {
    if (!sessionId) return;

    try {
      const res = await fetch(`/api/reserva/${sessionId}`);
      const data = await res.json();

      // Solo bloquear el pago si la reserva NO está vigente
      // (expirada, cancelada o no encontrada). Un error de red no bloquea.
      if (data && data.vigente && data.reserva?.expiraEn) {
        iniciarCuentaRegresiva(data.reserva.expiraEn);
      } else if (data && data.vigente === false) {
        marcarReservaExpirada();
      }
    } catch (error) {
      console.error('Error al verificar reserva:', error);
    }
  }

  // Verificar reserva al cargar
  verificarReserva();

  if (btn) {
    btn.addEventListener('click', async () => {
      btn.disabled = true;
      btnText.textContent = 'Conectando con ePayco...';
      btnSpinner.classList.remove('hidden');
      errorDiv.classList.add('hidden');

      try {
        await cargarScriptEpayco();

        const res = await fetch('/api/epayco/create-session', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (!res.ok) {
          const data = await res.json();
          throw new Error(data.error || data.detail || 'Error al procesar el pago');
        }

        const data = await res.json();

        if (!data.sessionId) {
          throw new Error('No se pudo inicializar la sesión de pago');
        }

        const checkout = ePayco.checkout.configure({
          sessionId: data.sessionId,
          type: 'standard',
          test: true,
        });

        checkout.open();
      } catch (err) {
        errorDiv.textContent = err instanceof Error ? err.message : 'Error inesperado. Intente nuevamente.';
        errorDiv.classList.remove('hidden');
        btn.disabled = false;
        btnText.textContent = 'Pagar con ePayco';
        btnSpinner.classList.add('hidden');
      }
    });
  }
</script>
