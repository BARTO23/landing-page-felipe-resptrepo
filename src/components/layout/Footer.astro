---
const phone = '3107285035';
const phoneClean = phone.replace(/\D/g, '');
const whatsappUrl = `https://wa.me/57${phoneClean}`;
const telUrl = `tel:+57${phoneClean}`;
const currentYear = new Date().getFullYear();
---

<footer class="bg-[#050510] text-white py-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">
      <div>
        <div class="w-12 h-12 bg-white/10 rounded-lg flex items-center justify-center mb-4">
          <span class="text-white font-headline font-bold text-lg">JFR</span>
        </div>
        <h3 class="font-headline font-bold text-xl mb-4">Juan Felipe Restrepo Sánchez</h3>
        <p class="text-white/60 text-sm leading-relaxed">
          Abogado especializado en derecho penal, laboral, civil y restitución de tierras. Atención personalizada en Apartadó y Urabá.
        </p>
      </div>

      <div>
        <h4 class="font-headline font-semibold text-lg mb-4 text-white/80">CONTACTO</h4>
        <ul class="space-y-4">
          <li>
            <a
              href={telUrl}
              class="inline-flex items-center gap-2 text-white/70 hover:text-white transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-white/50 rounded-md px-1"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56-.35-.12-.74-.03-1.01.24l-1.57 1.97c-2.83-1.35-5.48-3.9-6.89-6.83l1.95-1.66c.27-.28.35-.67.24-1.02-.37-1.11-.56-2.3-.56-3.53 0-.54-.45-.99-.99-.99H4.19C3.65 3 3 3.24 3 3.99 3 13.28 10.73 21 20.01 21c.71 0 .99-.63.99-1.18v-3.45c0-.54-.45-.99-.99-.99z"/>
              </svg>
              <span class="text-sm">310 454 7770</span>
            </a>
          </li>
          <li>
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-white/70 hover:text-white transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-white/50 rounded-md px-1"
            >
              <svg class="w-4 h-4 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              <span class="text-sm">Escríbanos por WhatsApp</span>
            </a>
          </li>
          <li class="flex items-center gap-2 text-white/70">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
            </svg>
            <span class="text-sm">Apartadó, Antioquia</span>
          </li>
        </ul>
      </div>

      <div>
        <h4 class="font-headline font-semibold text-lg mb-4 text-white/80">HORARIO</h4>
        <ul class="space-y-2 text-white/60 text-sm">
          <li>Lunes a Viernes: 8:00 AM - 6:00 PM</li>
          <li>Sábados: 9:00 AM - 1:00 PM</li>
          <li class="text-[#25D366]">Urgentencias: Disponible</li>
        </ul>
      </div>
    </div>

    <div class="pt-8 border-t border-white/10">
      <p class="text-center text-white/40 text-xs">
        &copy; {currentYear} Abogado Juan Felipe Restrepo Sánchez. Todos los derechos reservados.
      </p>
    </div>
  </div>
</footer>