---
import { servicios } from '../../data/servicios';
---

<section id="servicios" class="py-20 md:py-28 bg-[#e5e1e6]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-16">
      <p class="text-secondary font-semibold text-sm tracking-[0.2em] uppercase mb-4">
        Servicios
      </p>
      <h2 class="font-headline text-3xl md:text-4xl font-bold text-on-surface mb-4">
        ÁREAS DE PRÁCTICA
      </h2>

      <div class="flex items-center gap-2 overflow-x-auto pb-4">
        <div class="flex items-center gap-1">
          <span class="w-3 h-3 bg-secondary rounded-full"></span>
          <span class="text-xs font-semibold text-secondary whitespace-nowrap">DEFENSA PENAL</span>
        </div>
        <span class="text-outline mx-2">|</span>
        <div class="flex items-center gap-1">
          <span class="w-2 h-2 bg-outline rounded-full"></span>
          <span class="text-xs font-medium text-on-surface-variant whitespace-nowrap">DERECHO LABORAL</span>
        </div>
        <span class="text-outline mx-2">|</span>
        <div class="flex items-center gap-1">
          <span class="w-2 h-2 bg-outline rounded-full"></span>
          <span class="text-xs font-medium text-on-surface-variant whitespace-nowrap">DERECHO CIVIL</span>
        </div>
        <span class="text-outline mx-2">|</span>
        <div class="flex items-center gap-1">
          <span class="w-2 h-2 bg-outline rounded-full"></span>
          <span class="text-xs font-medium text-on-surface-variant whitespace-nowrap">RESTITUCIÓN DE TIERRAS</span>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {servicios.map((servicio, index) => (
        <article class="group bg-white p-8 rounded-lg transition-all duration-300 hover:shadow-lg flex flex-col">
          <div class="flex items-start gap-4 mb-6">
            <div class="w-12 h-12 bg-[#131645]/5 rounded-lg flex items-center justify-center flex-shrink-0">
              <span class="text-[#131645] font-headline font-bold text-lg">{index + 1}</span>
            </div>
            <div>
              <h3 class="font-headline text-lg font-semibold text-on-surface mb-3">
                {servicio.titulo}
              </h3>
              <p class="text-body-md text-on-surface-variant leading-relaxed">
                {servicio.descripcion}
              </p>
            </div>
          </div>
          <a
            href={`/agendar?servicio=${servicio.id}`}
            class="mt-auto self-start bg-primary-container text-on-primary px-5 py-2.5 rounded-lg font-bold text-sm hover:opacity-90 transition-all"
          >
            Programar Asesoría
          </a>
        </article>
      ))}
    </div>
  </div>
</section>