---
import { faqs } from '../../data/faqs';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.pregunta,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.respuesta
    }
  }))
};
---

<section id="faq" class="py-20 md:py-28 bg-surface">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <span class="inline-block px-4 py-1.5 bg-surface-container text-secondary text-label-md font-medium rounded-full mb-4">
        Preguntas Frecuentes
      </span>
      <h2 class="font-headline text-headline-md text-on-surface">
        Lo que necesita saber
      </h2>
    </div>

    <div class="space-y-4">
      {faqs.map((faq, index) => (
        <details class="group bg-surface-container-low rounded-lg overflow-hidden">
          <summary class="flex items-center justify-between p-6 cursor-pointer list-none focus:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-inset">
            <span class="font-headline font-semibold text-on-surface pr-4">
              {faq.pregunta}
            </span>
            <span class="flex-shrink-0 w-6 h-6 text-secondary transition-transform duration-200 group-open:rotate-180">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <div class="px-6 pb-6 text-body-md text-on-surface-variant leading-relaxed border-t border-outline-variant/15 pt-4">
            {faq.respuesta}
          </div>
        </details>
      ))}
    </div>

    <p class="text-center text-body-md text-on-surface-variant mt-8">
      ¿Tiene otra pregunta? <a href="#contacto" class="text-secondary font-semibold hover:underline">Escríbame</a>
    </p>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />