---
const phone = '3107285035';
const whatsappUrl = `https://wa.me/57${phone.replace(/\D/g, '')}`;
const callUrl = `tel:+57${phone.replace(/\D/g, '')}`;
---

<section class="relative min-h-[700px] md:min-h-[800px] pt-32 pb-20 overflow-hidden flex items-center bg-surface">
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-outline-variant to-transparent"></div>

  <div class="absolute top-40 left-0 w-96 h-96 bg-primary-container/5 rounded-full blur-3xl"></div>
  <div class="absolute -top-20 -right-20 w-80 h-80 bg-secondary-fixed rounded-full blur-[100px] opacity-30"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-8 w-full grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-center">
    <div class="md:col-span-7 z-10">
      <div class="mb-6 flex items-center gap-2 text-secondary font-bold tracking-widest uppercase text-xs">
        <span class="w-12 h-[1px] bg-secondary"></span>
        Estableciendo Autoridad Legal
      </div>

      <h1 class="text-5xl md:text-7xl font-black font-headline text-primary-container tracking-tighter leading-[0.9] mb-8">
        Juan Felipe <br /> Restrepo Sánchez
      </h1>

      <p class="text-xl md:text-2xl text-on-surface-variant font-medium leading-relaxed max-w-2xl mb-10">
        Abogado Especialista en Derecho Penal y Procesal Penal — <span class="text-secondary italic">Universidad Pontificia Bolivariana</span>.
      </p>

      <div class="flex flex-wrap gap-6">
        <a
          href="/agendar?servicio=penal"
          class="bg-primary-container text-on-primary px-8 py-4 rounded-lg font-bold text-lg hover:opacity-90 transition-all flex items-center gap-3"
        >
          Programar Asesoría
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
        </a>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="border border-outline px-8 py-4 rounded-lg font-bold text-lg hover:bg-surface-container-low transition-all"
        >
          Escríbeme a WhatsApp
        </a>
      </div>
    </div>

    <div class="md:col-span-5 relative hidden md:block">
      <div class="relative bg-white p-2 rounded-2xl shadow-2xl overflow-hidden transform rotate-2 hover:rotate-0 transition-transform duration-500">
        <img
          class="w-full h-[500px] object-cover rounded-xl"
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuAloM5-rzfMlfRZetiqLh797qSESMuDWZAF_fmIpF96czXKbHd6BvcF0M4VqaNFVrA2fmeuIxATz-e-st0R5bY9lh0qQx8WAgXGsBBBBP9ONZ4GRNmNxQGlFLZ0nNWY7O17VpulDyMl5pDbx2vNM_UQ6P6BecqqGQJpmf9EaHm-32mi4zz4Jp-sni28UDuVvFnSViWmeslMqEmzz-yopQaIIf2GtA1Py29giDfQwpVHN2DoQRdNzZ9zo6TzWiOrLelkim6OS61rZdQ"
          alt="Oficina de abogados elegante con mobiliario de madera oscura y documentos legales"
        />
        <div class="absolute bottom-8 left-8 right-8 bg-primary-container/90 backdrop-blur-md p-6 rounded-lg text-white">
          <svg class="w-10 h-10 mb-2" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
          </svg>
          <h3 class="text-xl font-bold font-headline mb-1">Defensa Rigurosa</h3>
          <p class="text-sm opacity-80">Estrategia legal basada en la precisión y la excelencia académica de la UPB.</p>
        </div>
      </div>
    </div>
  </div>
</section>