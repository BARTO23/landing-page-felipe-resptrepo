# ePayco - Pasarela de pagos Colombia
# Obtén tus llaves en: https://epayco.co
EPAYCO_PUBLIC_KEY=
EPAYCO_PRIVATE_KEY=
EPAYCO_CUSTOMER_ID=
EPAYCO_P_KEY=

# Resend - envío de correos de confirmación de cita
# Obtén tu API key en: https://resend.com/api-keys
RESEND_API_KEY=
# Remitente. Con dominio propio verificado: "Citas <citas@tudominio.com>"
# Sin dominio verificado puedes usar el de pruebas de Resend:
EMAIL_FROM=Citas <onboarding@resend.dev>

# Correo del abogado (recibe el aviso de cada cita nueva)
CONTACT_EMAIL=abogado@example.com
GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
